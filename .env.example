AGENTLY_STORE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SCHEMA=public
SUPABASE_STATE_TABLE=agently_state
SUPABASE_STATE_ROW_ID=primary
PORT=4000
ALLOWED_ORIGIN=*
# Optional server-level Twilio fallback for local development or single-tenant deployments.
# In SaaS mode, customers should connect Twilio from the Settings screen instead.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WEBHOOK_BASE_URL=https://your-public-backend.example.com
TWILIO_VALIDATE_REQUESTS=true
